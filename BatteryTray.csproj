<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 目标 .NET Framework 4.8：Windows 10 1903+ / Windows 11 系统自带，
         运行机无需安装 .NET Core / .NET 运行时，单文件产物约 88KB。 -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <AssemblyName>BatteryTray</AssemblyName>
    <RootNamespace>BatteryTray</RootNamespace>
    <Version>1.0.3</Version>
    <LangVersion>8.0</LangVersion>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <!-- 与原先 win-x64 产物保持一致：AnyCPU 下按 64 位运行 -->
    <Prefer32Bit>false</Prefer32Bit>
    <!-- 直接引用系统自带的 .NET Framework 程序集，离线可编译，无需 NuGet 参考程序集包 -->
    <FrameworkPathOverride Condition="'$(FrameworkPathOverride)' == '' and Exists('C:\Windows\Microsoft.NET\Framework64\v4.0.30319\mscorlib.dll')">C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

</Project>
